#!/usr/bin/env bash

set -u

export PATH="/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"

runtime_parent="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="${runtime_parent}/codex-dictation-${UID}"
unit_name="codex-dictation-record.service"
audio_file="${state_dir}/recording.wav"
window_file="${state_dir}/window-id"
lock_file="${state_dir}/toggle.lock"
record_log="${state_dir}/recording.log"
transcribe_log="${state_dir}/transcription.log"
model_file="${CODEX_DICTATION_MODEL:-${HOME}/.local/share/codex-dictation/models/ggml-base.en.bin}"
whisper_bin="${CODEX_DICTATION_WHISPER:-/home/linuxbrew/.linuxbrew/bin/whisper-cli}"
vocabulary_prompt="OpenAI Codex. Codex is a coding agent. GitHub, TypeScript, JavaScript, Python, Linux, Alacritty, PipeWire, and Whisper."

mkdir -p "${state_dir}"
chmod 700 "${state_dir}"

notify() {
    /usr/bin/notify-send \
        --app-name="Codex Dictation" \
        --icon="audio-input-microphone" \
        "$1" "$2" 2>/dev/null || true
}

delete_if_present() {
    if [[ -f "$1" ]]; then
        /usr/bin/unlink "$1"
    fi
}

active_state() {
    { /usr/bin/systemctl --user show --property=ActiveState --value "${unit_name}" 2>/dev/null || true; } | /usr/bin/head -n 1
}

is_recording() {
    local state
    state="$(active_state)"
    [[ "${state}" == "active" || "${state}" == "activating" || "${state}" == "deactivating" ]]
}

check_dependencies() {
    if [[ ! -x "${whisper_bin}" || ! -r "${model_file}" ]]; then
        notify "Codex dictation unavailable" "Local Whisper engine or model is missing."
        return 1
    fi
    return 0
}

start_recording() {
    if is_recording; then
        notify "Codex dictation" "Already recording; release Mod+Z to stop."
        return 0
    fi
    check_dependencies || return 1

    delete_if_present "${audio_file}"
    delete_if_present "${record_log}"
    delete_if_present "${transcribe_log}"

    local window_id
    if ! window_id="$(/usr/local/bin/xdotool getactivewindow 2>/dev/null)" || [[ -z "${window_id}" ]]; then
        notify "Codex dictation unavailable" "Could not identify the active terminal window."
        return 1
    fi
    printf '%s\n' "${window_id}" >"${window_file}"

    if ! /usr/bin/systemd-run \
        --user \
        --quiet \
        --collect \
        --unit="${unit_name}" \
        --property=Type=exec \
        --property=RuntimeMaxSec=5min \
        /usr/bin/pw-record \
        --rate 16000 \
        --channels 1 \
        --format s16 \
        "${audio_file}" \
        >>"${record_log}" 2>&1; then
        notify "Codex dictation failed" "The microphone recorder could not start."
        delete_if_present "${window_file}"
        return 1
    fi

    notify "Codex dictation recording" "Speak now; release Mod+Z when finished."
}

stop_recording() {
    if ! is_recording; then
        return 0
    fi

    /usr/bin/systemctl --user kill --signal=SIGINT "${unit_name}" 2>/dev/null || true
    for _ in {1..50}; do
        if ! is_recording; then
            break
        fi
        /usr/bin/sleep 0.1
    done

    if [[ ! -s "${audio_file}" ]]; then
        notify "Codex dictation failed" "No microphone audio was captured."
        delete_if_present "${window_file}"
        return 1
    fi

    notify "Codex dictation" "Transcribing locally…"

    local device_args=()
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L 2>/dev/null | /usr/bin/grep -q '^GPU 0:'; then
        device_args=(-dev 1)
    fi

    local transcript status text window_id
    transcript="$({ /usr/bin/timeout 120 "${whisper_bin}" \
        -m "${model_file}" \
        -f "${audio_file}" \
        -l en \
        --prompt "${vocabulary_prompt}" \
        -nt \
        -np \
        -t 8 \
        "${device_args[@]}"; } 2>"${transcribe_log}")"
    status=$?

    delete_if_present "${audio_file}"

    if [[ ${status} -ne 0 ]]; then
        notify "Codex dictation failed" "Local transcription failed; see ${transcribe_log}."
        delete_if_present "${window_file}"
        return 1
    fi

    text="$(printf '%s' "${transcript}" | /usr/bin/tr '\n' ' ' | /usr/bin/sed -E 's/[[:space:]]+/ /g;s/^ +//;s/ +$//')"
    text="$(printf '%s' "${text}" | /usr/bin/sed -E 's/\b[Cc]ode[[:space:]]+[Xx]\b/Codex/g;s/\b[Cc]odecks\b/Codex/g;s/\b[Cc]odex\b/Codex/g')"
    if [[ -z "${text}" || "${text}" =~ ^\[[^]]+\]$ ]]; then
        notify "Codex dictation" "No speech was detected."
        delete_if_present "${window_file}"
        return 0
    fi

    window_id="$(/usr/bin/head -n 1 "${window_file}" 2>/dev/null || true)"
    delete_if_present "${window_file}"

    if [[ "${CODEX_DICTATION_NO_INSERT:-0}" == "1" ]]; then
        printf '%s\n' "${text}"
        notify "Codex dictation ready" "Transcription completed (test mode)."
        return 0
    fi

    if [[ -z "${window_id}" ]] || ! /usr/local/bin/xdotool getwindowname "${window_id}" >/dev/null 2>&1; then
        notify "Codex dictation ready" "The original terminal closed before text could be inserted."
        return 1
    fi

    if ! /usr/local/bin/xdotool type \
        --window "${window_id}" \
        --clearmodifiers \
        --delay 1 \
        -- "${text}" 2>>"${transcribe_log}"; then
        printf '%s\n' 'insertion_status=failed' >>"${transcribe_log}"
        notify "Codex dictation failed" "The transcription could not be inserted."
        return 1
    fi

    printf '%s\n' 'insertion_status=success' >>"${transcribe_log}"
    notify "Codex dictation ready" "Transcription inserted locally."
}

exec 9>"${lock_file}"
if ! /home/linuxbrew/.linuxbrew/bin/flock -n 9; then
    notify "Codex dictation" "A recording or transcription is already being processed."
    exit 0
fi

case "${1:-}" in
    start)
        start_recording
        ;;
    stop)
        stop_recording
        ;;
    toggle)
        if is_recording; then stop_recording; else start_recording; fi
        ;;
    *)
        printf 'Usage: %s start|stop|toggle\n' "${0##*/}" >&2
        exit 2
        ;;
esac
