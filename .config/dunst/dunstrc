[global]
    # Compact, square notification stack inspired by the reference screenshot.
    monitor = 0
    follow = keyboard
    width = 291
    height = 300
    origin = top-right
    offset = 15x50
    notification_limit = 5

    progress_bar = false
    indicate_hidden = true
    transparency = 0
    separator_height = 0
    padding = 14
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 3
    gap_size = 0
    separator_color = frame
    sort = false

    font = Monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = center
    vertical_alignment = center
    ellipsize = middle
    show_indicators = false

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = off

    stack_duplicates = true
    hide_duplicate_count = false
    history_length = 20
    corner_radius = 0

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1A1412"
    foreground = "#3C7B82"
    frame_color = "#3C7B82"
    timeout = 6

[urgency_normal]
    background = "#1A1412"
    foreground = "#567734"
    frame_color = "#567734"
    timeout = 8

[urgency_critical]
    background = "#1A1412"
    foreground = "#B04027"
    frame_color = "#B04027"
    timeout = 90
